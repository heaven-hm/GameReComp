#!/usr/bin/env python3
"""Back-compat shim: the command is `RevEng` now.

Kept so existing scripts and documentation that call `./autorecomp` keep
working. It prints one line to stderr naming the new command, then runs exactly
the same entry point. New work should call `./RevEng`.
"""

import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))

print("note: this entry point is now `./RevEng`; `./autorecomp` still works",
      file=sys.stderr)

from tools.autorecomp.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
