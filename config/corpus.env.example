# Corpus roots for local end-to-end runs. Copy to config/corpus.env and set
# the paths, or export them in your shell. No paths are baked into the tools.
#
# Only metadata (paths, hashes, PE header facts) is written into reports/.
# Game binaries and assets are never copied into this repository.

# Small open-source games used for the first end-to-end vertical slice.
SMALL_GAMES_PATH=/path/to/recomp-apps/games

# Larger commercial games for the benchmark matrix. May be unset; inventory
# then reports MISSING_INPUT instead of guessing.
LARGE_GAMES_PATH=/path/to/recomp-apps/large-games
