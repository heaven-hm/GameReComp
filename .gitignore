# Build output and generated artifacts
build/
out/
/target/
**/target/
/dist/
*.app/
*.dSYM/
*.dylib
*.so
*.a
*.exe
*.dll
*.obj
*.o
*.pdb
*.ilk
*.lib

# Python
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/

# IDE and editor-local state
.vs/
.vscode/
*.suo
*.user
.idea/
*.swp
*.swo
*~

# Generated recomp output
src/game/recomp/gen/
RecompiledFuncs/

# OS
Thumbs.db
desktop.ini
.DS_Store
.AppleDouble
.LSOverride

# Original binaries (never commit these)
*.iso
*.bin
*.cue
*.dat
*.pak
*.pk3

# The one exception: the synthetic PE32 fixture the test suite and CI build
# themselves (tests/fixtures/make_pe32_fixture.py). It is our own bytes, it
# contains no third-party code, and --check fails if it drifts.
!tests/fixtures/*.exe

# Claude
.claude/

# Qoder session data
.qoder/

# Generated autorecomp projects (rebuilt output; never commit)
projects/

# IDA-derived Win16 ordinal map. Built locally by tools/ne/idt_to_json.py from
# an IDA install; it is IDA's data, not ours to redistribute.
tools/ne/win16_imports.json

# rev.ng container staging (a binary from outside the repo, for the
# duration of one decompilation; never committed)
.revng-in/

# rev.ng's marked-up C for a whole game is 146 MB and is a derived
# artifact; the stripped .c beside it is what the pipeline reads.
*.ptml
# rev.ng's stderr capture for that same step; keep it out of status, it is
# empty on success and a tool log, not evidence, either way.
*.ptml.err

# rev.ng decompilation of a whole game: 5.1 MB of C and 146 MB of marked-up C.
# Both are derived; regenerate with
#   python3 -m tools.autorecomp.revng <exe> --out highlevel/<game>/<game>-revng.c
highlevel/*/[a-z]*-revng.c
# wip/
#
# Work in progress that is deliberately NOT in the tree: a half-written
# transform that fails its own tests is worse than the refusal it replaced,
# so it is parked here rather than committed and imported. Anything here is
# scratch; the durable form of a decision is a commit, not a file in this
# directory.
wip/
# rev.ng per-function output for a whole game: 957 files, 5.8 MB, derived and
# regenerable. The stripped single-file C is what the pipeline reads.
highlevel/*/revng
# rev.ng project mode: one analysis, then cheap artifacts.
.revng-project/
highlevel/*/.revng-project/
# rev.ng's generated headers for a whole game: 760 KB of recovered type layouts
# and x87 helper declarations, derived from the binary. Regenerate with the
# recipe in tools/autorecomp/revng.py.
highlevel/*/types-and-globals.h
highlevel/*/helpers.h
highlevel/*/attributes.h
highlevel/*/primitive-types.h
highlevel/*/runtime-library.h
highlevel/*/*.ptml
# Qt build tree for the GUI (Phase 5); regenerated by cmake.
gui/build/

# Rust build artifacts
/target/

# Local test, benchmark, and tool output
/benchmark-results/
/test-results/
*.log
*.tmp
*.bak

# Local environment and credentials
.env
.env.*
!.env.example
*.pem
*.key

# Command Code agent state (taste, session scratch); not part of the project.
.commandcode/
.opencode/

# Generated autorecomp project trees (multi-GB, regenerable; never commit).
# Covers the default `projects/<game>` layout at any directory depth and the
# `<name>-project` layout written by tools/{full_corpus_sweep,oracle_sweep}.py
# wherever --out points, so a generated tree can never leak into git.
**/projects/
**/*-project/

# local generated build trees (regenerable; never commit)
/.chocd-new/
/.igi-rebuild/
/.tetris-new/
/results/
reports/linux-matrix/staging/
