# Build output
build/
out/
*.exe
*.dll
*.obj
*.o
*.pdb
*.ilk
*.lib

# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# IDE
.vs/
.vscode/
*.suo
*.user
.idea/

# Generated recomp output
src/game/recomp/gen/
RecompiledFuncs/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Original binaries (never commit these)
*.iso
*.bin
*.cue
*.dat
*.pak
*.pk3

# The one exception: the synthetic PE32 fixture the test suite and CI build
# themselves (tests/fixtures/make_pe32_fixture.py). It is our own bytes, it
# contains no third-party code, and --check fails if it drifts.
!tests/fixtures/*.exe

# Claude
.claude/

# Qoder session data
.qoder/

# Generated autorecomp projects (rebuilt output; never commit)
projects/

# IDA-derived Win16 ordinal map. Built locally by tools/ne/idt_to_json.py from
# an IDA install; it is IDA's data, not ours to redistribute.
tools/ne/win16_imports.json

# rev.ng container staging (a binary from outside the repo, for the
# duration of one decompilation; never committed)
.revng-in/

# rev.ng's marked-up C for a whole game is 146 MB and is a derived
# artifact; the stripped .c beside it is what the pipeline reads.
*.ptml

# rev.ng decompilation of a whole game: 5.1 MB of C and 146 MB of marked-up C.
# Both are derived; regenerate with
#   python3 -m tools.autorecomp.revng <exe> --out highlevel/<game>/<game>-revng.c
highlevel/*/[a-z]*-revng.c
# wip/
#
# Work in progress that is deliberately NOT in the tree: a half-written
# transform that fails its own tests is worse than the refusal it replaced,
# so it is parked here rather than committed and imported. Anything here is
# scratch; the durable form of a decision is a commit, not a file in this
# directory.
wip/
