+/* MSVC's reentrant wcstok: the caller keeps the cursor in its context word. */
+static int wcstok_delim(uint32_t delim, uint16_t ch) {
+    for (uint32_t p = delim; MEM16(p); p += 2) if (MEM16(p) == ch) return 1;
+    return 0;
+}
+static void c_wcsstr(void) {
+    uint32_t h = A32(0), n = A32(1);
+    if (!h || !n) RETC(0);
+    for (uint32_t p = h; MEM16(p); p += 2) {
+        uint32_t i = 0;
+        while (MEM16(n + 2u * i) && MEM16(p + 2u * i) == MEM16(n + 2u * i)) i++;
+        if (!MEM16(n + 2u * i)) RETC(p);
+    }
+    RETC(0);
+}
+static void c_wcstok(void) {
+    uint32_t s = A32(0), delim = A32(1), ctx = A32(2);
+    if (!ctx || !delim) RETC(0);
+    uint32_t start = s ? s : MEM32(ctx);
+    if (!start) RETC(0);
+    while (MEM16(start) && wcstok_delim(delim, MEM16(start))) start += 2;
+    if (!MEM16(start)) { MEM32(ctx) = 0; RETC(0); }
+    uint32_t tok = start;
+    while (MEM16(start) && !wcstok_delim(delim, MEM16(start))) start += 2;
+    if (MEM16(start)) { MEM16(start) = 0; MEM32(ctx) = start + 2; }
+    else MEM32(ctx) = 0;
+    RETC(tok);
+}
