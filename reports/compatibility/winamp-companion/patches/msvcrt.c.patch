+static void c_Mtx_destroy_in_situ(void)  { RETCV(); }
+static void c_Mtx_lock(void)             { RETCV(); }
+static void c_Mtx_unlock(void)           { RETCV(); }
+static void c_Cnd_destroy_in_situ(void)  { RETCV(); }
+static void c_Cnd_signal(void)           { RETCV(); }
+/* MSVCP140's exception/error helpers (the guest's own CRT code calls them). */
